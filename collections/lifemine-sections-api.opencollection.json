{
  "opencollection": "1.0.0",
  "info": {
    "name": "LifeMine Careers API (Greenhouse Job Board) Sections API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "sections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List board sections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://boards-api.greenhouse.io/v1/boards/lifeminetx/sections"
          },
          "docs": "Board sections. Empty on LifeMine's board when observed: `{\"sections\": []}`."
        },
        {
          "info": {
            "name": "Get one section",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://boards-api.greenhouse.io/v1/boards/lifeminetx/sections/:section_id",
            "params": [
              {
                "name": "section_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get one section"
        }
      ]
    }
  ],
  "bundled": true
}